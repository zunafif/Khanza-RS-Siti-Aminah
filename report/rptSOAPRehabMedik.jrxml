	<parameter name="no_rawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    		rp.no_rawat, ps.no_rkm_medis, ps.nm_pasien, rp.umurdaftar, rp.sttsumur, IF(ps.jk='L','Laki-Laki','Perempuan') AS jk, ps.tgl_lahir,

    /* ===== DATA AWAL ===== */
    a.tgl_perawatan   AS tanggal_awal,
    a.jam_rawat       AS jam_awal,
    a.keluhan         AS Subject,
    a.evaluasi        AS Evaluasi,
    a.pemeriksaan     AS Objek,
    a.penilaian       AS Assesmen,
    a.rtl             AS Plan,
    a.instruksi       AS Instruksi,
    a.tgl_perawatan   AS tgl_perawatan,

    /* ===== DATA AKHIR ===== */
    b.tgl_perawatan   AS tanggal_akhir,
    b.jam_rawat       AS jam_akhir,
    b.keluhan         AS Subject1,
    b.evaluasi        AS Evaluasi1,
    b.pemeriksaan     AS Objek1,
    b.penilaian       AS Assesmen1,
    b.rtl             AS Plan1,
    b.instruksi       AS Instruksi1,
    b.tgl_perawatan   AS tgl_perawatan1,

    /* ===== PETUGAS ===== */
    p.nik,
    p.nama AS nama_petugas

FROM pemeriksaan_ralan a
INNER JOIN pemeriksaan_ralan b
    ON a.no_rawat = b.no_rawat

/* ===== JOIN PETUGAS ===== */
LEFT JOIN pegawai p
    ON a.nip = p.nik

WHERE a.no_rawat = $P{no_rawat}

/* ===== RECORD AWAL ===== */
AND (a.tgl_perawatan, a.jam_rawat) = (
    SELECT tgl_perawatan, jam_rawat
    FROM pemeriksaan_ralan
    WHERE no_rawat = a.no_rawat
    ORDER BY tgl_perawatan ASC, jam_rawat ASC
    LIMIT 1
)

/* ===== RECORD AKHIR ===== */
AND (b.tgl_perawatan, b.jam_rawat) = (
    SELECT tgl_perawatan, jam_rawat
    FROM pemeriksaan_ralan
    WHERE no_rawat = b.no_rawat
    ORDER BY tgl_perawatan DESC, jam_rawat DESC
    LIMIT 1
)]]>
	</queryString>
